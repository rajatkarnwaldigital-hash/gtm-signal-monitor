# Local testing only. On GitHub Actions set these as repository Secrets
# (Settings -> Secrets and variables -> Actions). Never commit a real .env.

# Contacts + company verification (Exa). Without it the digest still sends,
# just with no contact and no fact-checking of stage/headcount.
EXA_API_KEY=

# Required to generate the "why now" hook and opener per lead.
ANTHROPIC_API_KEY=

# Gmail address the digest is sent from.
GMAIL_ADDRESS=

# Gmail App Password, not your normal password.
# https://myaccount.google.com/apppasswords (needs 2-Step Verification)
GMAIL_APP_PASSWORD=

# Where the digest lands.
RECIPIENT_EMAIL=

# Optional tuning.
# DAILY_CAP=5
# SCORE_FLOOR=8
